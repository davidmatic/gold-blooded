---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Section } from "../site/sections";

interface Props {
  section: Section;
}

const { section } = Astro.props;
---
<BaseLayout title={section.name}>
  <h1>{section.name}</h1>
  <p>{section.blurb}</p>
  <p class="placeholder">Coming soon.</p>
</BaseLayout>
