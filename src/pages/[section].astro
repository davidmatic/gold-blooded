---
// Placeholder pages for each section until its own ticket gives it a real page.
// When a section gets a real page (src/pages/<slug>.astro or src/pages/<slug>/index.astro),
// stop generating its placeholder here so the two routes don't collide.
import ComingSoon from "../components/ComingSoon.astro";
import { sections } from "../site/sections";

export function getStaticPaths() {
  // Sections that have their own pages now. (getStaticPaths can't see frontmatter variables.)
  const realPages = new Set(["news", "archive", "season-stats", "purdy-shrine"]);
  return sections.filter((section) => !realPages.has(section.slug)).map((section) => ({ params: { section: section.slug }, props: { section } }));
}

const { section } = Astro.props;
---
<ComingSoon section={section} />
